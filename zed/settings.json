// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "session": {
    "trust_all_worktrees": true
  },
  "indent_guides": {
    "enabled": false
  },
  "diff_view_style": "unified",
  "project_panel": {
    "dock": "right"
  },
  "cli_default_open_behavior": "new_window",
  "agent": {
    "threads_sidebar": {
      "position": "left"
    },
    "message_editor_bordered": true,
    "dock": "left",
    "favorite_models": [],
    "model_parameters": [],
    "expand_terminal_card": false
  },
  "terminal": {
    "font_family": "PlemolJP Console NF"
  },
  "base_keymap": "VSCode",
  "relative_line_numbers": "enabled",
  "gutter": {
    "line_numbers": true
  },
  "minimap": {
    "show": "never"
  },
  "colorize_brackets": false,
  "format_on_save": "on",
  "buffer_font_weight": 400.0,
  "agent_buffer_font_size": 11.0,
  "agent_ui_font_size": 13.0,
  "show_edit_predictions": false,
  "disable_ai": true,
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    },
    "cursor": {
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "model": "opus",
        "mode": "auto"
      },
      "type": "registry",
    },
  },
  "buffer_line_height": "comfortable",
  "icon_theme": {
    "mode": "light",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "vim_mode": true,
  "ui_font_family": ".ZedMono",
  "buffer_font_family": "PlemolJP Console NF",
  "ui_font_size": 13.0,
  "buffer_font_size": 12.0,
  "theme": {
    "mode": "light",
    "light": "Modus Operandi Tritanopia",
    "dark": "Modus Vivendi Tritanopia"
  },
  // TS/JS: tsgo (typescript-ls) + oxlint/oxfmt. Listing servers without "..."
  // disables the rest (vtsls, typescript-language-server, eslint).
  // For eslint/prettier projects, override in that repo's .zed/settings.json.
  "languages": {
    "TypeScript": {
      "colorize_brackets": false,
      "format_on_save": "on",
      "language_servers": ["typescript-ls", "oxlint", "oxfmt"],
      "prettier": { "allowed": false },
      "formatter": [
        { "language_server": { "name": "oxfmt" } },
        { "code_action": "source.fixAll.oxc" },
      ],
    },
    "TSX": {
      "colorize_brackets": false,
      "format_on_save": "on",
      "language_servers": ["typescript-ls", "oxlint", "oxfmt"],
      "prettier": { "allowed": false },
      "formatter": [
        { "language_server": { "name": "oxfmt" } },
        { "code_action": "source.fixAll.oxc" },
      ],
    },
    "JavaScript": {
      "colorize_brackets": false,
      "format_on_save": "on",
      "language_servers": ["typescript-ls", "oxlint", "oxfmt"],
      "prettier": { "allowed": false },
      "formatter": [
        { "language_server": { "name": "oxfmt" } },
        { "code_action": "source.fixAll.oxc" },
      ],
    },
    "JSX": {
      "colorize_brackets": false,
      "format_on_save": "on",
      "language_servers": ["typescript-ls", "oxlint", "oxfmt"],
      "prettier": { "allowed": false },
      "formatter": [
        { "language_server": { "name": "oxfmt" } },
        { "code_action": "source.fixAll.oxc" },
      ],
    },
  },
}
