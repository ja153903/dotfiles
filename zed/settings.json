// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "new_window",
  "disable_ai": true,
  "vim_mode": true,
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "ui_font_family": "PlemolJP Console NF",
  "buffer_font_family": "PlemolJP Console NF",
  "ui_font_size": 15.0,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "dark",
    "light": "Modus Operandi Tinted",
    "dark": "Modus Vivendi Tinted",
  },
  // One TS server only: tsgo extension (typescript-ls). TS 7 ships no tsserver.js, so
  // vtsls/typescript-language-server can't use it; "..." keeps others (e.g. oxc).
  "languages": {
    "TypeScript": { "language_servers": ["typescript-ls", "!typescript-language-server", "!vtsls", "..."] },
    "TSX": { "language_servers": ["typescript-ls", "!typescript-language-server", "!vtsls", "..."] },
    "JavaScript": { "language_servers": ["typescript-ls", "!typescript-language-server", "!vtsls", "..."] },
    // Mirrors nvim: basedpyright for types, ruff for lint + format.
    "Python": {
      "language_servers": ["basedpyright", "ruff"],
      "formatter": { "language_server": { "name": "ruff" } },
    },
  },
  "lsp": {
    // Apple's /usr/bin/clangd (21) lags on C++23/26 (e.g. no std::generator); use Homebrew's.
    // Unversioned path so `brew upgrade llvm` picks up C++26 reflection when clang ships it.
    "clangd": { "binary": { "path": "/opt/homebrew/opt/llvm/bin/clangd" } },
  },
}
