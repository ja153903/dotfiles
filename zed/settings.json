// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "disable_ai": true,
  "vim_mode": true,
  "icon_theme": "Zed (Default)",
  "ui_font_family": "PlemolJP Console NF",
  "buffer_font_family": "PlemolJP Console NF",
  "ui_font_size": 15.0,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "dark",
    "light": "Modus Operandi Tinted",
    "dark": "Modus Vivendi Tinted",
  },
  // One TS server only; vtsls (built-in) + tsgo (extension) caused duplicate results.
  "languages": {
    "TypeScript": { "language_servers": ["typescript-language-server"] },
    "TSX": { "language_servers": ["typescript-language-server"] },
    "JavaScript": { "language_servers": ["typescript-language-server"] },
    // Mirrors nvim: basedpyright for types, ruff for lint + format.
    "Python": {
      "language_servers": ["basedpyright", "ruff"],
      "formatter": { "language_server": { "name": "ruff" } },
    },
  },
}
