theme = "koda-dark"
background = #1E1C31
font-family = "Monaspace Krypton"
font-thicken = true

font-size = 12

cursor-style = block
cursor-style-blink = true

shell-integration=fish
shell-integration-features=no-cursor

freetype-load-flags = no-hinting

scrollback-limit = 500000

bold-is-bright = true

macos-option-as-alt = true

adjust-cell-height = +25%

clipboard-read = ask
clipboard-write = allow

background-opacity = 0.9
background-blur-radius = 30

# Keybinds
keybind = alt+p>n=new_split:right
keybind = alt+p>shift+n=new_split:left
keybind = alt+p>d=new_split:down
keybind = alt+p>shift+d=new_split:up

keybind = alt+r>shift+l=resize_split:right,50
keybind = alt+r>shift+h=resize_split:left,50
keybind = alt+r>shift+j=resize_split:down,50
keybind = alt+r>shift+k=resize_split:up,50
keybind = alt+r>equal=equalize_splits

keybind = alt+t>l=next_tab
keybind = alt+t>h=previous_tab

keybind = shift+enter=text:\n

keybind = alt+l=goto_split:right
keybind = alt+j=goto_split:bottom
keybind = alt+k=goto_split:top
keybind = alt+h=goto_split:left
